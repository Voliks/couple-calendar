# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Публичный HTTPS-адрес, где доступен этот сервер (Telegram требует HTTPS)
WEBAPP_URL=https://your-domain.example
# Порт локального веб-сервера
PORT=8080
# Путь к файлу SQLite
DB_PATH=calendar.db
# Продакшен-БД (без неё на Render база пропадает при деплое); оба или ни одного
TURSO_URL=
TURSO_TOKEN=
# Фото челленджей: Supabase → Settings → API (service_role) + приватный бакет "challenges" в Storage
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=challenges
# Голосовые заметки (необязательно)
GROQ_API_KEY=
# Час отправки напоминаний (по времени пользователя)
REMINDER_HOUR=9
